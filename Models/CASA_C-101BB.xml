<PropertyList>

  <!-- corpo novo: modelo externo + cockpit_PILOT.xml + instrumentos em canvas -->
  <foo include="CASA_C-101_common.xml" omit-node="y" />

  <!-- detalhes externos da variante BB -->
  <model>
    <path>Aircraft/C-101/Models/C-101_EB-BB_details.xml</path>
  </model>

  <model>
    <path>Aircraft/C-101/Models/C-101_tailfins.xml</path>
  </model>

  <!-- canhão DEFA 553 -->
  <model>
    <path>Aircraft/C-101/Models/Armament/DEFA553/DEFA553.xml</path>
  </model>

  <!-- mira SAAB RGS-2 (interior, característica das versões de ataque) -->
  <model>
    <name>Gun Sight</name>
    <path>Aircraft/C-101/Models/Instruments/Sight/SAAB_RGS-2.xml</path>
    <condition>
      <property>/sim/model/c101/sight</property>
    </condition>
    <offsets>
      <x-m>-3.92</x-m>
      <y-m> 0.00</y-m>
      <z-m> 0.315</z-m>
      <pitch-deg>-10</pitch-deg>
    </offsets>
  </model>

  <model>
    <name>Gun Sight Camera</name>
    <path>Aircraft/C-101/Models/Instruments/Sight/SAAB_RGS-2_camera.xml</path>
    <condition>
      <property>/sim/model/c101/sight</property>
    </condition>
    <offsets>
      <x-m>-3.92</x-m>
      <y-m> 0.00</y-m>
      <z-m> 0.315</z-m>
      <pitch-deg>-10</pitch-deg>
    </offsets>
  </model>

  <!-- Livery dialog -->
  <nasal>
    <load>
      var livery_update = aircraft.livery_update.new("Aircraft/C-101/Models/Liveries_C-101BB");
    </load>
    <unload>
      livery_update.stop();
    </unload>
  </nasal>

</PropertyList>
