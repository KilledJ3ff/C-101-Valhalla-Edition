  <!-- ================================================= MOUSE CLICKABLE CONTROLS -->
<!-- These picks must stay after the rotate/translate animations that move the
     same objects, otherwise the handler is attached before the object moves.
     All actions use the left button only. -->

  <!-- Landing gear lever -->
  <animation>
    <type>pick</type>
    <object-name>landingGearKnob</object-name>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>nasal</command>
        <script>controls.gearToggle();</script>
      </binding>
    </action>
    <hovered>
      <binding>
        <command>set-tooltip</command>
        <tooltip-id>c101-gear-lever</tooltip-id>
        <label>Landing gear: %s (click to toggle)</label>
        <property>/controls/gear/gear-down</property>
        <mapping>nasal</mapping>
        <script>return arg[0] ? 'DOWN' : 'UP';</script>
      </binding>
    </hovered>
  </animation>

  <!-- Parking brake handle -->
  <animation>
    <type>pick</type>
    <object-name>parkingBrakeHandle</object-name>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>nasal</command>
        <script>controls.parkingBrakeToggle(1);</script>
      </binding>
    </action>
    <hovered>
      <binding>
        <command>set-tooltip</command>
        <tooltip-id>c101-parking-brake</tooltip-id>
        <label>Parking brake: %s (click to toggle)</label>
        <property>/controls/gear/brake-parking</property>
        <mapping>nasal</mapping>
        <script>return arg[0] ? 'ON' : 'OFF';</script>
      </binding>
    </hovered>
  </animation>

  <!-- Flaps: one notch per click. The lever and the DOWN placard lower the
       flaps, the UP placard raises them (right-click cannot be used: in
       FlightGear 2024.1 the right button is reserved for the spring-loaded
       look mode and never reaches the pick callbacks). -->
  <animation>
    <type>pick</type>
    <object-name>flapLever</object-name>
    <object-name>flapsDOWN</object-name>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>nasal</command>
        <script>controls.flapsDown(1);</script>
      </binding>
    </action>
    <hovered>
      <binding>
        <command>set-tooltip</command>
        <tooltip-id>c101-flaps-down</tooltip-id>
        <label>Flaps: %s (click to lower one notch)</label>
        <property>/controls/flight/flaps</property>
        <mapping>nasal</mapping>
        <script>var f = arg[0]; return f &lt; 0.01 ? 'UP' : (f &lt; 0.7 ? 'TAKEOFF' : 'DOWN');</script>
      </binding>
    </hovered>
  </animation>

  <animation>
    <type>pick</type>
    <object-name>flapsUP</object-name>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>nasal</command>
        <script>controls.flapsDown(-1);</script>
      </binding>
    </action>
    <hovered>
      <binding>
        <command>set-tooltip</command>
        <tooltip-id>c101-flaps-up</tooltip-id>
