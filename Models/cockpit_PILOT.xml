<!-- Kollsman window drums. FlightGear only maintains setting-inhg, so the
       drums are driven by it; the old factors were degrees per hPa, now
       scaled by 33.8639 (hPa per inHg): 36 -> 1219.1 deg/inHg, etc. -->
<animation><type>rotate</type><object-name>hpaUnits</object-name>
  <property>instrumentation/altimeter/setting-inhg</property>
  <factor>1219.104</factor>
  <center><x-m>-4.019</x-m><!-- back --><z-m> 0.124</z-m><!-- up --></center> 
  <axis><y>-1</y></axis>
 </animation> 
 <animation><type>rotate</type><object-name>hpaTens</object-name>
  <property>instrumentation/altimeter/setting-inhg</property>
  <factor>121.9104</factor>
  <center><x-m>-4.019</x-m><!-- back --><z-m> 0.124</z-m><!-- up --></center> 
  <axis><y>-1</y></axis>
 </animation> 
 <animation><type>rotate</type><object-name>hpaHundreds</object-name>
  <property>instrumentation/altimeter/setting-inhg</property>
  <factor>12.19104</factor>
  <center><x-m>-4.019</x-m><!-- back --><z-m> 0.124</z-m><!-- up --></center> 
  <axis><y>-1</y></axis>
 </animation> 
 <animation><type>rotate</type><object-name>hpaThousands</object-name>
  <property>instrumentation/altimeter/setting-inhg</property>
  <factor>1.219104</factor>
  <center><x-m>-4.019</x-m><!-- back --><z-m> 0.124</z-m><!-- up --></center> 
  <axis><y>-1</y></axis>
 </animation>
 
