    <action>
      <binding>
        <command>property-adjust</command>
        <property>/instrumentation/nav[0]/volume</property>
        <factor type="double">0.05</factor>
        <min>0</min>
        <max>1</max>
        <wrap>false</wrap>
      </binding>
    </action>
    <hovered>
      <binding>
        <command>set-tooltip</command>
        <tooltip-id>c101-nav1-volume</tooltip-id>
        <label>NAV1 volume: %s (scroll/click to turn)</label>
        <property>/instrumentation/nav[0]/volume</property>
        <mapping>nasal</mapping>
        <script>return sprintf("%.0f%%", arg[0] * 100);</script>
      </binding>
    </hovered>
  </animation>

  <!-- Pitch trim wheel -->
  <animation>
    <type>knob</type>
    <object-name>trim</object-name>
    <property>/controls/flight/elevator-trim</property>
    <factor>90</factor>
    <center><x-m>-4.00368</x-m><y-m>-0.22075</y-m><z-m>0.13949</z-m></center>
    <axis><x>0</x><y>0</y><z>1</z></axis>
    <action>
      <binding>
        <command>property-adjust</command>
        <property>/controls/flight/elevator-trim</property>
        <factor type="double">0.02</factor>
        <min>-1</min>
        <max>1</max>
        <wrap>false</wrap>
      </binding>
    </action>
    <hovered>
      <binding>
        <command>set-tooltip</command>
        <tooltip-id>c101-pitch-trim</tooltip-id>
        <label>Pitch trim: %s (scroll/click to adjust)</label>
        <property>/controls/flight/elevator-trim</property>
        <mapping>nasal</mapping>
        <script>return sprintf("%+.0f%% nose %s", arg[0] * 100, arg[0] &gt; 0 ? 'down' : (arg[0] &lt; 0 ? 'up' : 'trim'));</script>
      </binding>
    </hovered>
  </animation>

  <!-- Lighting switches -->
  <animation>
    <type>pick</type>
    <object-name>switchPosition</object-name>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>property-toggle</command>
        <property>/controls/lighting/nav-lights</property>
      </binding>
    </action>
    <hovered>
      <binding>
        <command>set-tooltip</command>
        <tooltip-id>c101-nav-lights</tooltip-id>
        <label>Position lights: %s (click to toggle)</label>
        <property>/controls/lighting/nav-lights</property>
        <mapping>nasal</mapping>
        <script>return arg[0] ? 'ON' : 'OFF';</script>
      </binding>
    </hovered>
  </animation>

  <animation>
    <type>pick</type>
    <object-name>switchAntiCol</object-name>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>property-toggle</command>
        <property>/controls/lighting/beacon</property>
      </binding>
    </action>
    <hovered>
      <binding>
        <command>set-tooltip</command>
        <tooltip-id>c101-beacon</tooltip-id>
        <label>Anti-collision beacon: %s (click to toggle)</label>
        <property>/controls/lighting/beacon</property>
        <mapping>nasal</mapping>
        <script>return arg[0] ? 'ON' : 'OFF';</script>
      </binding>
    </hovered>
  </animation>

  <animation>
    <type>pick</type>
    <object-name>switchFormation</object-name>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>property-toggle</command>
        <property>/controls/lighting/formation_lighting</property>
      </binding>
    </action>
    <hovered>
      <binding>
        <command>set-tooltip</command>
        <tooltip-id>c101-formation-lights</tooltip-id>
        <label>Formation lights: %s (click to toggle)</label>
        <property>/controls/lighting/formation_lighting</property>
        <mapping>nasal</mapping>
        <script>return arg[0] ? 'ON' : 'OFF';</script>
      </binding>
    </hovered>
  </animation>

   <effect><!-- SHADERS -->
	<inherits-from>Aircraft/C-101/Models/Effects/reflect_glass</inherits-from>
		<object-name>Instrument_glass</object-name>
  </effect> 

</PropertyList>